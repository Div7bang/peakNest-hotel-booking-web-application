<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | PeakNest</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { font-family: 'Jost', sans-serif; background: var(--snow); }

    .dashboard-container { display: flex; min-height: 100vh; }

    .sidebar {
      width: 250px;
      background-color: var(--pine);
      color: white;
      padding-top: 20px;
      position: fixed;
      height: 100vh;
      overflow-y: auto;
    }

    .sidebar-brand {
      padding: 0 20px 15px;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--forest);
    }
    .sidebar-brand h4 {
      margin: 0;
      font-family: 'Cormorant Garamond', serif;
      font-size: 24px;
      font-weight: 400;
      color: var(--gold-light);
    }

    .sidebar-menu { list-style: none; padding: 0; margin: 0; }

    .sidebar-menu li {
      padding: 14px 20px;
      border-bottom: 1px solid var(--forest);
      cursor: pointer;
      transition: background-color 0.3s;
      font-size: 13px;
      letter-spacing: 0.5px;
    }

    .sidebar-menu li:hover { background-color: var(--forest); }

    .sidebar-menu li.active {
      background-color: var(--sage);
      border-left: 4px solid var(--gold);
    }

    .sidebar-menu li a { color: white; text-decoration: none; display: block; }

    .main-content {
      margin-left: 250px;
      flex: 1;
      background-color: var(--snow);
      padding: 24px;
    }

    .dashboard-header {
      background-color: white;
      padding: 20px 24px;
      border-radius: 8px;
      box-shadow: var(--shadow-card);
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .dashboard-header h1 {
      margin: 0;
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      color: var(--pine);
    }

    .user-info { display: flex; align-items: center; gap: 15px; font-size: 14px; }

    .logout-btn {
      background-color: #c0392b;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 3px;
      cursor: pointer;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: background-color 0.3s;
    }

    .logout-btn:hover { background-color: #a5281b; }

    .dashboard-content { display: none; }
    .dashboard-content.active { display: block; }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }

    .stat-card {
      background-color: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: var(--shadow-card);
      text-align: center;
    }

    .stat-card h3 {
      margin: 0 0 10px 0;
      color: var(--warm-gray);
      font-size: 12px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 500;
    }

    .stat-card .value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 36px;
      color: var(--pine);
      font-weight: 600;
    }

    .table-container {
      background-color: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: var(--shadow-card);
    }

    .table-container table { width: 100%; border-collapse: collapse; }

    .table-container th {
      background-color: var(--pine);
      color: white;
      padding: 12px;
      text-align: left;
      font-weight: 500;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .table-container td { padding: 12px; border-bottom: 1px solid var(--cream); font-size: 14px; }

    .table-container tr:hover { background-color: var(--snow); }

    .action-btn {
      padding: 6px 12px;
      margin: 2px;
      border: none;
      border-radius: 3px;
      cursor: pointer;
      font-size: 11px;
      letter-spacing: 0.5px;
      transition: opacity 0.3s;
    }

    .edit-btn { background-color: var(--sage); color: white; }
    .delete-btn { background-color: #c0392b; color: white; }
    .action-btn:hover { opacity: 0.8; }

    .form-section {
      background-color: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: var(--shadow-card);
      max-width: 600px;
    }

    .form-section h2 {
      font-family: 'Cormorant Garamond', serif;
      color: var(--pine);
      margin-top: 0;
      font-weight: 500;
    }

    .form-group { margin-bottom: 15px; }

    .form-group label {
      display: block;
      margin-bottom: 5px;
      color: var(--pine);
      font-weight: 500;
      font-size: 13px;
    }

    .form-group input, .form-group select {
      width: 100%;
      padding: 10px;
      border: 1px solid var(--mist);
      border-radius: 3px;
      font-size: 14px;
      font-family: 'Jost', sans-serif;
      background: var(--snow);
    }

    .form-group input:focus, .form-group select:focus {
      outline: none;
      border-color: var(--sage);
      box-shadow: 0 0 0 3px rgba(107,143,107,0.12);
      background: white;
    }

    .submit-btn {
      background-color: var(--gold);
      color: white;
      padding: 11px 22px;
      border: none;
      border-radius: 3px;
      cursor: pointer;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: background-color 0.3s;
    }

    .submit-btn:hover { background-color: var(--gold-light); }

    .message { padding: 15px; border-radius: 6px; margin-bottom: 15px; display: none; font-size: 14px; }
    .message.success { background-color: #e3f0e3; color: var(--forest); border: 1px solid var(--sage); display: block; }
    .message.error { background-color: #fbe4e1; color: #a5281b; border: 1px solid #e6a49c; display: block; }

    @media (max-width: 768px) {
      .sidebar { width: 100%; height: auto; position: relative; padding-bottom: 10px; }
      .main-content { margin-left: 0; }
      .dashboard-header { flex-direction: column; gap: 15px; align-items: flex-start; }
      .stats-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <div class="sidebar">
      <div class="sidebar-brand">
        <h4>Peak<span style="color:white">Nest</span> Admin</h4>
      </div>
      <ul class="sidebar-menu">
        <li class="active" onclick="showSection('overview', this)"><a href="javascript:void(0)">📊 Overview</a></li>
        <li onclick="showSection('users', this)"><a href="javascript:void(0)">👥 Manage Users</a></li>
        <li onclick="showSection('adduser', this)"><a href="javascript:void(0)">➕ Add User</a></li>
        <li onclick="showSection('hotels', this)"><a href="javascript:void(0)">🏨 Manage Hotels</a></li>
        <li onclick="showSection('addhotel', this)"><a href="javascript:void(0)">➕ Add Hotel</a></li>
        <li onclick="showSection('settings', this)"><a href="javascript:void(0)">⚙️ Settings</a></li>
        <li onclick="logoutAdmin()"><a href="javascript:void(0)">🚪 Logout</a></li>
      </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
      <div class="dashboard-header">
        <h1>Admin Dashboard</h1>
        <div class="user-info">
          <span id="adminName">Admin</span>
          <button class="logout-btn" onclick="logoutAdmin()">Logout</button>
        </div>
      </div>

      <div id="message" class="message"></div>

      <!-- Overview Section -->
      <div id="overview" class="dashboard-content active">
        <div class="stats-grid">
          <div class="stat-card">
            <h3>Total Users</h3>
            <div class="value" id="totalUsers">0</div>
          </div>
          <div class="stat-card">
            <h3>Admin Accounts</h3>
            <div class="value" id="totalAdmins">1</div>
          </div>
          <div class="stat-card">
            <h3>Regular Users</h3>
            <div class="value" id="totalRegularUsers">0</div>
          </div>
          <div class="stat-card">
            <h3>System Status</h3>
            <div class="value" style="color: var(--sage); font-size:22px;">Active</div>
          </div>
        </div>

        <div class="table-container">
          <h3 style="font-family:'Cormorant Garamond',serif;color:var(--pine);font-weight:500;">Recent Users</h3>
          <table>
            <thead>
              <tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th></tr>
            </thead>
            <tbody id="recentUsersTable">
              <tr><td colspan="4" style="text-align: center; color: var(--warm-gray);">No users yet</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Manage Users Section -->
      <div id="users" class="dashboard-content">
        <div class="table-container">
          <h2 style="font-family:'Cormorant Garamond',serif;color:var(--pine);font-weight:500;margin-top:0;">Manage Users</h2>
          <table>
            <thead>
              <tr><th>Name</th><th>Email</th><th>Role</th><th>Joined Date</th><th>Actions</th></tr>
            </thead>
            <tbody id="usersTable">
              <tr><td colspan="5" style="text-align: center; color: var(--warm-gray);">Loading users...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add User Section -->
      <div id="adduser" class="dashboard-content">
        <div class="form-section">
          <h2>Add New User</h2>
          <form id="addUserForm">
            <div class="form-group"><label for="fullname">Full Name *</label><input type="text" id="fullname" name="fullname" required></div>
            <div class="form-group"><label for="newemail">Email *</label><input type="email" id="newemail" name="newemail" required></div>
            <div class="form-group"><label for="newpassword">Password *</label><input type="password" id="newpassword" name="newpassword" required></div>
            <div class="form-group">
              <label for="newrole">Role *</label>
              <select id="newrole" name="newrole" required>
                <option value="">Select a role</option>
                <option value="user">User</option>
                <option value="admin">Admin</option>
              </select>
            </div>
            <button type="submit" class="submit-btn">Add User</button>
          </form>
        </div>
      </div>

      <!-- Settings Section -->
      <div id="settings" class="dashboard-content">
        <div class="form-section">
          <h2>Admin Settings</h2>
          <div style="margin-bottom: 20px;">
            <h4 style="color:var(--pine);">System Information</h4>
            <p><strong>Admin Status:</strong> <span style="color: var(--sage);">Active</span></p>
            <p><strong>Session Token:</strong> <span style="font-size: 12px; color: var(--warm-gray);">Active</span></p>
            <p><strong>Last Login:</strong> <span id="lastLogin">Just now</span></p>
          </div>
          <hr>
          <h4 style="color:var(--pine);">Account Management</h4>
          <button class="submit-btn" onclick="alert('Password change feature coming soon!');" style="margin-bottom: 10px;">Change Password</button>
          <button class="submit-btn" onclick="alert('Two-factor authentication coming soon!');">Enable 2FA</button>
        </div>
      </div>

      <!-- Manage Hotels Section -->
      <div id="hotels" class="dashboard-content">
        <div class="table-container">
          <h2 style="font-family:'Cormorant Garamond',serif;color:var(--pine);font-weight:500;margin-top:0;">Manage Hotels</h2>
          <table>
            <thead>
              <tr><th>Name</th><th>Location</th><th>Price</th><th>Rating</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody id="hotelsTable">
              <tr><td colspan="6" style="text-align: center; color: var(--warm-gray);">Loading hotels...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Hotel Section -->
      <div id="addhotel" class="dashboard-content">
        <div class="form-section">
          <h2>Add New Hotel</h2>
          <form id="addHotelForm">
            <div class="form-group"><label for="hotelName">Hotel Name *</label><input type="text" id="hotelName" name="hotelName" placeholder="e.g., Wildflower Hall" required></div>
            <div class="form-group"><label for="hotelLocation">Location *</label><input type="text" id="hotelLocation" name="hotelLocation" placeholder="e.g., Shimla" required></div>
            <div class="form-group"><label for="hotelDescription">Description</label><input type="text" id="hotelDescription" name="hotelDescription" placeholder="Brief description of the hotel"></div>
            <div class="form-group"><label for="hotelImage">Image URL</label><input type="text" id="hotelImage" name="hotelImage" placeholder="https://... or /images/hotel.jpg"></div>
            <div class="form-group"><label for="hotelPrice">Price / Night (₹) *</label><input type="number" id="hotelPrice" name="hotelPrice" min="0" step="1" placeholder="0" required></div>
            <div class="form-group"><label for="hotelRating">Rating</label><input type="text" id="hotelRating" name="hotelRating" placeholder="4.5"></div>
            <button type="submit" class="submit-btn">Add Hotel</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const adminName = localStorage.getItem('adminName') || 'Admin';
      document.getElementById('adminName').textContent = adminName;

      loadDashboardData();
      loadUsers();
      loadHotels();
    });

    function showSection(sectionId, element) {
      document.querySelectorAll('.dashboard-content').forEach(section => section.classList.remove('active'));
      document.querySelectorAll('.sidebar-menu li').forEach(item => item.classList.remove('active'));
      document.getElementById(sectionId).classList.add('active');
      element.classList.add('active');
    }

    async function loadDashboardData() {
      try {
        const response = await fetch('/api/auth/dashboard-stats');
        if (response.ok) {
          const data = await response.json();
          document.getElementById('totalUsers').textContent = data.totalUsers || 0;
          document.getElementById('totalAdmins').textContent = data.totalAdmins || 1;
          document.getElementById('totalRegularUsers').textContent = data.totalRegularUsers || 0;

          if (data.recentUsers && data.recentUsers.length > 0) {
            const tbody = document.getElementById('recentUsersTable');
            tbody.innerHTML = data.recentUsers.map(user => `
              <tr>
                <td>${user.fullname}</td>
                <td>${user.email}</td>
                <td><span style="background-color: ${user.role === 'admin' ? '#b8963e' : '#8a8680'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">${user.role}</span></td>
                <td>${new Date(user.createdAt).toLocaleDateString()}</td>
              </tr>
            `).join('');
          }
        }
      } catch (error) {
        console.error('Error loading dashboard data:', error);
      }
    }

    async function loadUsers() {
      try {
        const response = await fetch('/api/auth/all-users');
        if (response.ok) {
          const data = await response.json();
          const tbody = document.getElementById('usersTable');

          if (data.users && data.users.length > 0) {
            tbody.innerHTML = data.users.map(user => `
              <tr>
                <td>${user.fullname}</td>
                <td>${user.email}</td>
                <td><span style="background-color: ${user.role === 'admin' ? '#b8963e' : '#8a8680'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">${user.role}</span></td>
                <td>${new Date(user.createdAt).toLocaleDateString()}</td>
                <td>
                  <button class="action-btn edit-btn" onclick="editUser('${user._id}')">Edit</button>
                  <button class="action-btn delete-btn" onclick="deleteUser('${user._id}')">Delete</button>
                </td>
              </tr>
            `).join('');
          } else {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #8a8680;">No users found</td></tr>';
          }
        }
      } catch (error) {
        console.error('Error loading users:', error);
      }
    }

    document.getElementById('addUserForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fullname = document.getElementById('fullname').value;
      const email = document.getElementById('newemail').value;
      const password = document.getElementById('newpassword').value;
      const role = document.getElementById('newrole').value;

      try {
        const response = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fullname, email, password, role })
        });

        const result = await response.json();
        const msgEl = document.getElementById('message');

        if (response.ok && result.user) {
          msgEl.className = 'message success';
          msgEl.textContent = 'User added successfully!';
          document.getElementById('addUserForm').reset();
          loadUsers();
          setTimeout(() => msgEl.className = 'message', 3000);
        } else {
          msgEl.className = 'message error';
          msgEl.textContent = result.message || 'Error adding user';
          setTimeout(() => msgEl.className = 'message', 3000);
        }
      } catch (error) {
        const msgEl = document.getElementById('message');
        msgEl.className = 'message error';
        msgEl.textContent = 'Error communicating with server';
        setTimeout(() => msgEl.className = 'message', 3000);
      }
    });

    function deleteUser(userId) {
      if (confirm('Are you sure you want to delete this user?')) {
        alert('Delete functionality will be implemented in the next update');
      }
    }

    function editUser(userId) {
      alert('Edit functionality will be implemented in the next update');
    }

    function logoutAdmin() {
      if (confirm('Are you sure you want to logout?')) {
        fetch('/api/auth/logout', { method: 'GET' })
          .then(() => { window.location.href = '/admin/login'; })
          .catch(error => console.error('Logout error:', error));
      }
    }

    async function loadHotels() {
      try {
        const response = await fetch('/api/auth/hotels');
        if (response.ok) {
          const data = await response.json();
          const tbody = document.getElementById('hotelsTable');

          if (data.hotels && data.hotels.length > 0) {
            tbody.innerHTML = data.hotels.map(hotel => `
              <tr>
                <td>${hotel.name}</td>
                <td>${hotel.location}</td>
                <td>₹${hotel.price}</td>
                <td>${hotel.rating}</td>
                <td><span style="background-color: ${hotel.status === 'active' ? '#6b8f6b' : '#8a8680'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">${hotel.status}</span></td>
                <td>
                  <button class="action-btn edit-btn" onclick="editHotel('${hotel._id}')">Edit</button>
                  <button class="action-btn delete-btn" onclick="deleteHotel('${hotel._id}')">Delete</button>
                </td>
              </tr>
            `).join('');
          } else {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #8a8680;">No hotels found</td></tr>';
          }
        }
      } catch (error) {
        console.error('Error loading hotels:', error);
      }
    }

    document.getElementById('addHotelForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = document.getElementById('hotelName').value;
      const location = document.getElementById('hotelLocation').value;
      const description = document.getElementById('hotelDescription').value;
      const image = document.getElementById('hotelImage').value;
      const price = parseFloat(document.getElementById('hotelPrice').value);
      const rating = document.getElementById('hotelRating').value;

      try {
        const response = await fetch('/api/auth/hotels', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, location, description, image, price, rating })
        });

        const result = await response.json();
        const msgEl = document.getElementById('message');

        if (response.ok && result.hotel) {
          msgEl.className = 'message success';
          msgEl.textContent = 'Hotel added successfully!';
          document.getElementById('addHotelForm').reset();
          loadHotels();
          setTimeout(() => msgEl.className = 'message', 3000);
        } else {
          msgEl.className = 'message error';
          msgEl.textContent = result.message || 'Error adding hotel';
          setTimeout(() => msgEl.className = 'message', 3000);
        }
      } catch (error) {
        const msgEl = document.getElementById('message');
        msgEl.className = 'message error';
        msgEl.textContent = 'Error communicating with server';
        setTimeout(() => msgEl.className = 'message', 3000);
      }
    });

    function deleteHotel(hotelId) {
      if (confirm('Are you sure you want to delete this hotel?')) {
        fetch(`/api/auth/hotels/${hotelId}`, { method: 'DELETE' })
          .then(response => response.json())
          .then(result => {
            const msgEl = document.getElementById('message');
            if (result.message) {
              msgEl.className = 'message success';
              msgEl.textContent = 'Hotel deleted successfully!';
              loadHotels();
            } else {
              msgEl.className = 'message error';
              msgEl.textContent = 'Error deleting hotel';
            }
            setTimeout(() => msgEl.className = 'message', 3000);
          })
          .catch(error => {
            const msgEl = document.getElementById('message');
            msgEl.className = 'message error';
            msgEl.textContent = 'Error deleting hotel';
            setTimeout(() => msgEl.className = 'message', 3000);
          });
      }
    }

    function editHotel(hotelId) {
      alert('Edit functionality will be implemented in the next update');
    }
  </script>
</body>

</html>
